# Red Nexus - Environment Variables
# Copy this file to .env and fill in your values

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rednexus_db

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret_string
CLIENT_URL=http://localhost:3000

# ── Admin Account Bootstrap ──────────────────────────────────────────────────
# Set ONCE to create first admin, then leave blank
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email / SMTP (Gmail recommended) ─────────────────────────────────────────
# Use a Gmail App Password (not your real password)
# Enable at: myaccount.google.com > Security > 2-Step > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Red Nexus Blood Bank <your_email@gmail.com>"
